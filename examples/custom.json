{
  "version": "0.1",
  "meta": { "title": "自定义组件示例", "lang": "zh-CN" },
  "components": [
    {
      "name": "Signature",
      "description": "落款：右对齐的署名和日期",
      "props": { "who": { "type": "string", "required": true }, "date": { "type": "string" } },
      "template": {
        "root": "s",
        "elements": {
          "s": { "type": "Text", "props": { "text": "{{who}}　{{date}}" }, "style": { "align": "right", "color": "#666666" } }
        }
      }
    }
  ],
  "root": "doc",
  "elements": {
    "doc": { "type": "Document", "children": ["ch1", "tip", "sign"] },
    "ch1": { "type": "Chapter", "props": { "n": 1, "title": "为什么要自定义组件", "lead": [{ "text": "把常用的排版" }, { "text": "组合起来", "bold": true }, { "text": "，JSON 里一行引用。" }] } },
    "tip": { "type": "Callout", "props": { "title": "提示" }, "children": ["tip-body", "tip-list"] },
    "tip-body": { "type": "Text", "props": { "text": "组件定义放在文档旁边的 catalog/ 目录里，会自动读取；也可以用 --catalog 指定，或者像落款这样直接写进文档的 components。" } },
    "tip-list": { "type": "List", "props": { "items": ["定义文件用 JSON", "模板里只能用内置组件和别的自定义组件"] } },
    "sign": { "type": "Signature", "props": { "who": "pewp", "date": "2026-10-28" } }
  }
}
